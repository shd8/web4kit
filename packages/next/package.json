{
  "name": "@web4kit/next",
  "version": "0.1.0",
  "description": "web4 for Next.js: one call from a server component plans, resolves and previews a page per visitor.",
  "license": "MIT",
  "author": "Fernando Gómez Graciani",
  "homepage": "https://github.com/shd8/web4kit/tree/main/packages/next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shd8/web4kit.git",
    "directory": "packages/next"
  },
  "bugs": "https://github.com/shd8/web4kit/issues",
  "keywords": [
    "web4",
    "system-one",
    "jev",
    "decision-model",
    "personalization",
    "generative-ui",
    "page-planning",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@web4kit/context": "workspace:^",
    "@web4kit/decider": "workspace:^",
    "@web4kit/ir": "workspace:^",
    "@web4kit/manifest": "workspace:^",
    "@web4kit/planner": "workspace:^",
    "@web4kit/react": "workspace:^"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  },
  "devDependencies": {
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
