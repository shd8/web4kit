{
  "name": "@web4kit/react",
  "version": "0.1.0",
  "description": "web4 React renderer and curated component library: fail-soft, server-renderable, container-query based.",
  "license": "MIT",
  "author": "Fernando Gómez Graciani",
  "homepage": "https://github.com/shd8/web4/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shd8/web4.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/shd8/web4/issues",
  "keywords": [
    "web4",
    "system-one",
    "jev",
    "decision-model",
    "personalization",
    "generative-ui",
    "page-planning"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./tokens.css": "./dist/tokens.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepack": "tsdown && tailwindcss -i src/styles.css -o dist/styles.css --minify"
  },
  "dependencies": {
    "@web4kit/ir": "workspace:^",
    "@web4kit/manifest": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
