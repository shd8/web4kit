{
  "name": "@web4kit/planner",
  "version": "0.1.0",
  "description": "web4 planner: one decider round (what, how, where), confidence gating, plan cache and portability lint.",
  "license": "MIT",
  "author": "Fernando Gómez Graciani",
  "homepage": "https://github.com/shd8/web4kit/tree/main/packages/planner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shd8/web4kit.git",
    "directory": "packages/planner"
  },
  "bugs": "https://github.com/shd8/web4kit/issues",
  "keywords": [
    "web4",
    "system-one",
    "jev",
    "decision-model",
    "personalization",
    "generative-ui",
    "page-planning"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@web4kit/context": "workspace:^",
    "@web4kit/decider": "workspace:^",
    "@web4kit/ir": "workspace:^",
    "@web4kit/manifest": "workspace:^",
    "@web4kit/solver": "workspace:^",
    "zod": "^4.6.5"
  }
}
